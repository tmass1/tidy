#!/usr/bin/env python3
"""Deploy the landing page (site/) to production at tidy-app.tommymassaro.com.

This is the only way to deploy production. Before it deploys it checks that this checkout has
every commit that's already live, so a deploy can't quietly take work off the site. Every deploy
records its commit and branch on the Cloudflare version, which is how the next deploy knows
what's live. See docs/deploying.md for what each stop means.

  scripts/deploy-site --check     everything except the dry-run build and the deploy
  scripts/deploy-site             check, build, confirm, deploy, verify
  scripts/deploy-site --yes       no prompts (only after Tommy said yes in chat); stops still stop

Standard library only, like the rest of the project.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

WORKER = "tidy-app"
SITE_URL = "https://tidy-app.tommymassaro.com"
MAIN = "main"
REMOTE = "origin"
# Everything the deploy uploads or depends on. Uncommitted changes here stop a deploy.
BUILD_INPUTS = ["site", "wrangler.jsonc", "scripts/deploy-site"]
# Paths that must never be served. The site is public, so nothing needs a sign-in.
HIDDEN_PATHS = ["/.DS_Store", "/wrangler.jsonc", "/.git/config", "/CLAUDE.md", "/scripts/deploy-site"]
NOTE = re.compile(r"\bcommit=([0-9a-f]{40})\b")
SCRIPT_ROOT = Path(__file__).resolve().parent.parent


class Stop(Exception):
    """A reason not to deploy. Nothing (not even --yes) gets past one."""

    def __init__(self, title: str, detail: str):
        super().__init__(title)
        self.title = title
        self.detail = detail


# Git

class Repo:
    def __init__(self, path: Path):
        self.path = Path(path)

    def git(self, *args: str, check: bool = True, input: str | None = None) -> str:
        result = subprocess.run(["git", "-C", str(self.path), *args], capture_output=True,
                                text=True, input=input)
        if check and result.returncode != 0:
            raise RuntimeError(f"git {' '.join(args)} failed: {result.stderr.strip()}")
        return result.stdout.strip()

    def ok(self, *args: str) -> bool:
        return subprocess.run(["git", "-C", str(self.path), *args], capture_output=True).returncode == 0

    def has_commit(self, sha: str) -> bool:
        return self.ok("cat-file", "-e", f"{sha}^{{commit}}")

    def resolve(self, rev: str) -> str | None:
        out = self.git("rev-parse", "--verify", "--quiet", f"{rev}^{{commit}}", check=False)
        return out or None

    def contains(self, ancestor: str, rev: str = "HEAD") -> bool:
        return self.ok("merge-base", "--is-ancestor", ancestor, rev)

    def branch(self) -> str | None:
        return self.git("branch", "--show-current") or None

    def short(self, sha: str) -> str:
        return self.git("log", "-1", "--format=%h %s", sha)

    def log(self, rng: str) -> list[str]:
        out = self.git("log", "--format=%h %s", rng)
        return out.splitlines() if out else []

    def count(self, rng: str) -> int:
        return int(self.git("rev-list", "--count", rng) or 0)

    def site_files(self, rev: str = "HEAD") -> dict[str, str]:
        """site/ paths (relative to site/) -> blob ids at a commit."""
        return tree_files(self, f"{rev}:site")


def blob_id(data: bytes) -> str:
    """The id git gives a file with these exact bytes."""
    return hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()


# Cloudflare Web Analytics adds its beacon to HTML pages as it serves some requests (a zone setting,
# not part of the site), so live pages are compared with that one tag taken out.
BEACON = re.compile(rb'<script[^>]*static\.cloudflareinsights\.com/beacon[^>]*>\s*</script>\n?')


def served_blob_id(path: str, body: bytes) -> str:
    """The blob id of a live file, as it was committed."""
    if path.endswith(".html"):
        body = BEACON.sub(b"", body)
    return blob_id(body)


def url_for(path: str) -> str:
    """site/ path -> the URL Cloudflare serves it at (html_handling: auto-trailing-slash)."""
    if path == "index.html":
        return "/"
    if path.endswith("/index.html"):
        return "/" + path[: -len("index.html")]
    if path.endswith(".html"):
        return "/" + path[: -len(".html")]
    return "/" + path


# Cloudflare and the live site

def wrangler_cmd() -> list[str]:
    return ["wrangler"] if shutil.which("wrangler") else ["npx", "--yes", "wrangler"]


def parse_json(text: str):
    start = min([i for i in (text.find("{"), text.find("[")) if i >= 0], default=-1)
    if start < 0:
        raise ValueError("no JSON in wrangler's output")
    return json.loads(text[start:])


class Cloudflare:
    def __init__(self, repo: Repo):
        self.repo = repo

    def run(self, *args: str, capture: bool = True) -> subprocess.CompletedProcess:
        return subprocess.run([*wrangler_cmd(), *args], cwd=self.repo.path, text=True,
                              capture_output=capture)

    def live_version(self) -> tuple[str, str | None]:
        """(version id, its note) for the version serving 100% of traffic."""
        status = self.run("deployments", "status", "--json")
        if status.returncode != 0:
            raise Stop("Couldn't ask Cloudflare what's live",
                       "wrangler deployments status failed. Check you're signed in with `wrangler whoami`.\n"
                       + status.stderr.strip()[-600:])
        deployment = parse_json(status.stdout)
        versions = deployment.get("versions") or []
        if len(versions) != 1:
            raise Stop("The live site is split between versions",
                       "Cloudflare is serving more than one version at once (a gradual rollout), so there's no "
                       "single live commit. Finish or undo the rollout in Cloudflare, then run this again.")
        version_id = versions[0]["version_id"]
        view = self.run("versions", "view", version_id, "--json")
        notes = [deployment.get("annotations", {}).get("workers/message", "")]
        if view.returncode == 0:
            annotations = parse_json(view.stdout).get("annotations", {})
            notes.insert(0, annotations.get("workers/message", ""))
        note = next((n for n in notes if n and NOTE.search(n)), None)
        return version_id, note

    def dry_run(self) -> subprocess.CompletedProcess:
        return self.run("deploy", "--dry-run")

    def deploy(self, message: str, tag: str) -> int:
        return self.run("deploy", "--message", message, "--tag", tag, capture=False).returncode


def fetch(path: str, timeout: float = 15) -> tuple[int, bytes]:
    """GET a path on the live site, skipping caches. Returns (status, body)."""
    sep = "&" if "?" in path else "?"
    req = urllib.request.Request(f"{SITE_URL}{path}{sep}deploy-check={int(time.time())}",
                                 headers={"User-Agent": "tidy-deploy-site", "Cache-Control": "no-cache"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, resp.read()
    except urllib.error.HTTPError as err:
        return err.code, b""
    except (urllib.error.URLError, TimeoutError) as err:
        raise Stop("Couldn't reach the live site", f"{SITE_URL}{path}: {err}")


# The checks

def check_clean(repo: Repo) -> None:
    """1. Nothing the deploy uploads may be changed, new or ignored-but-present."""
    out = repo.git("status", "--porcelain", "--ignored", "--untracked-files=all", "--", *BUILD_INPUTS)
    if out:
        raise Stop("There are uncommitted changes in files the site uses",
                   "These would be deployed, or left out, without being in any commit:\n"
                   + "\n".join("  " + line for line in out.splitlines())
                   + "\n\nCommit them (or remove them) and run this again. A file marked !! is ignored by git "
                     "but sits in site/, so Cloudflare would upload it: delete it.")


def match_live_content(repo: Repo, fetcher=fetch) -> str | None:
    """For deploys made before notes existed: find the commit whose site/ matches what's live.

    Returns the earliest commit with that exact site/, or None if no single version matches."""
    status, live_index = fetcher("/")
    if status != 200:
        raise Stop("The live home page didn't load", f"{SITE_URL}/ returned {status}.")
    commits = repo.git("rev-list", "--branches", "--remotes", "--tags").splitlines()
    if not commits:
        return None
    batch = repo.git("cat-file", "--batch-check", input="\n".join(f"{c}:site" for c in commits) + "\n")
    trees: dict[str, list[str]] = {}
    for commit, line in zip(commits, batch.splitlines()):
        parts = line.split()
        if len(parts) == 3 and parts[1] == "tree":
            trees.setdefault(parts[0], []).append(commit)
    wanted = served_blob_id("index.html", live_index)
    live_cache: dict[str, str | None] = {}

    def live_blob(path: str) -> str | None:
        if path not in live_cache:
            code, body = fetcher(url_for(path))
            live_cache[path] = served_blob_id(path, body) if code == 200 else None
        return live_cache[path]

    matches = []
    for tree, tree_commits in trees.items():
        files = tree_files(repo, tree)
        if files.get("index.html") != wanted:
            continue
        if all(live_blob(path) == blob for path, blob in files.items()):
            matches.append(tree_commits)
    if len(matches) != 1:
        return None
    same_site = set(matches[0])
    oldest_first = repo.git("rev-list", "--topo-order", "--reverse", *same_site).splitlines()
    return next(c for c in oldest_first if c in same_site)


def tree_files(repo: Repo, tree: str) -> dict[str, str]:
    out = repo.git("ls-tree", "-r", tree)
    files = {}
    for line in out.splitlines():
        meta, path = line.split("\t", 1)
        files[path] = meta.split()[2]
    return files


def find_live_commit(repo: Repo, cf: Cloudflare, given: str | None, fetcher=fetch):
    """2. Which commit is live. Returns (sha, how, version_id)."""
    version_id, note = cf.live_version()
    if given:
        sha = repo.resolve(given)
        if not sha:
            raise Stop("The commit you named isn't in this checkout",
                       f"`{given}` doesn't match any commit here. Run `git fetch {REMOTE}` first; if it still "
                       "isn't found, push it from the checkout or computer where it was made.")
        return sha, "named with --live-commit", version_id
    if note:
        sha = NOTE.search(note).group(1)
        if not repo.has_commit(sha):
            raise Stop("The live commit isn't in this checkout",
                       f"Cloudflare says commit {sha[:12]} is live ({note}), but this checkout has never seen it.\n"
                       f"Run `git fetch {REMOTE}`. If it's still missing, it was deployed from a checkout or computer "
                       "whose work isn't pushed: push it from there, fetch here, and run this again.")
        return sha, "recorded on the live deploy", version_id
    sha = match_live_content(repo, fetcher)
    if not sha:
        raise Stop("Can't tell which commit is live",
                   "The live version has no commit note (it was deployed before this check existed), and its "
                   "files don't match exactly one version of site/ in this checkout.\n"
                   f"Run `git fetch {REMOTE}` and try again. If that doesn't help, find the commit that was deployed "
                   "(the release notes or the deploy time in `wrangler deployments list` can help) and name it:\n"
                   "  scripts/deploy-site --check --live-commit <commit>")
    return sha, "matched by comparing the live files with past commits", version_id


def check_contains_live(repo: Repo, live: str) -> None:
    """3. This branch must already have everything that's live."""
    if repo.contains(live):
        return
    lost = repo.log(f"HEAD..{live}")
    refs = repo.git("branch", "-a", "--contains", live, "--format=%(refname)").splitlines()
    holders = [re.sub(r"^refs/(heads|remotes)/", "", r) for r in refs if r and not r.endswith("/HEAD")]
    where = ("Merge one of these, which have it: " + ", ".join(holders)) if holders else \
        f"No branch here has it; it may only be on a detached checkout. `git merge {live[:12]}` brings it in."
    raise Stop("This branch is missing work that's live",
               f"Deploying would take these {len(lost)} live commit(s) off the site:\n"
               + "\n".join("  " + line for line in lost)
               + f"\n\n{where}\nThen run this again.")


def confirmations(repo: Repo, fetched: bool) -> list[str]:
    """4. Things that aren't wrong but need a yes."""
    asks = []
    branch = repo.branch()
    if branch != MAIN:
        asks.append(f"You're deploying from {branch or 'a detached checkout'}, not {MAIN}. "
                    f"Remember to merge it into {MAIN} afterwards.")
    if not fetched:
        asks.append(f"Couldn't fetch from {REMOTE}, so what GitHub has may be out of date.")
    upstream = repo.git("rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}", check=False) if branch else ""
    if not upstream and not repo.git("branch", "-r", "--contains", "HEAD"):
        asks.append(f"{branch or 'This commit'} hasn't been pushed to {REMOTE}, so this work exists only on "
                    "this computer.")
    if upstream:
        ahead, behind = repo.count(f"{upstream}..HEAD"), repo.count(f"HEAD..{upstream}")
        if ahead:
            asks.append(f"{ahead} commit(s) here aren't pushed to {upstream} yet.")
        if behind:
            asks.append(f"{upstream} has {behind} commit(s) you don't have. Pull or merge them first unless "
                        "you mean to leave them out.")
    main_remote = f"{REMOTE}/{MAIN}"
    if repo.resolve(main_remote) and upstream != main_remote:
        missing = repo.count(f"HEAD..{main_remote}")
        if missing:
            asks.append(f"{main_remote} has {missing} commit(s) this branch doesn't. They may not be live yet, "
                        "but they'd stay off the site.")
    return asks


def site_references(site: Path) -> list[str]:
    """Local files index.html points at that don't exist."""
    html = (site / "index.html").read_text(encoding="utf-8")
    html = re.sub(r"/\*.*?\*/|<!--.*?-->", "", html, flags=re.S)  # examples in comments aren't links
    refs = re.findall(r'(?:src|href)\s*=\s*"([^"]+)"', html) + re.findall(r'url\(\s*["\']?([^"\')]+)', html)
    missing = []
    for ref in refs:
        if re.match(r"^(?:[a-z]+:|//|#)", ref) or ref.startswith("data:"):
            continue
        path = ref.split("#")[0].split("?")[0].lstrip("/")
        if path and not (site / path).exists() and not (site / path / "index.html").exists():
            missing.append(ref)
    return sorted(set(missing))


def config_exposure(repo: Repo) -> list[str]:
    """Settings that would publish the site at extra addresses."""
    text = (repo.path / "wrangler.jsonc").read_text(encoding="utf-8")
    text = "\n".join(line for line in text.splitlines() if not line.strip().startswith("//"))
    config = json.loads(text)
    problems = []
    if config.get("workers_dev") is not False:
        problems.append("workers_dev isn't false, so the site would also be served on a workers.dev address")
    if config.get("preview_urls") is not False:
        problems.append("preview_urls isn't false, so every version would get a public preview link")
    return problems


def run_checks(repo: Repo, cf: Cloudflare, build: bool) -> None:
    """5. Tests, the site's own references, and (when deploying) Wrangler's dry-run build."""
    tests = subprocess.run([sys.executable, "-m", "unittest", "discover", "-s", str(SCRIPT_ROOT / "scripts" / "tests"),
                            "-q"], capture_output=True, text=True)
    if tests.returncode != 0:
        raise Stop("The deploy script's tests failed", (tests.stdout + tests.stderr).strip()[-1500:])
    print("  ✓ deploy script tests pass")
    missing = site_references(repo.path / "site")
    if missing:
        raise Stop("The page points at files that don't exist",
                   "site/index.html refers to:\n" + "\n".join("  " + m for m in missing))
    print("  ✓ every file the page refers to is there")
    exposure = config_exposure(repo)
    if exposure:
        raise Stop("wrangler.jsonc would publish the site somewhere extra", "\n".join("  " + p for p in exposure))
    print("  ✓ no workers.dev or preview addresses")
    if build:
        result = cf.dry_run()
        if result.returncode != 0:
            raise Stop("The production build (wrangler deploy --dry-run) failed",
                       (result.stdout + result.stderr).strip()[-1500:])
        print("  ✓ production build (dry run) works")


def verify_live(repo: Repo, fetcher=fetch, wait: float = 90) -> list[str]:
    """8. The live site serves exactly this commit's files and nothing hidden. Returns problems."""
    files = repo.site_files("HEAD")
    deadline = time.time() + wait
    while True:
        wrong = []
        for path, blob in files.items():
            code, body = fetcher(url_for(path))
            if code != 200:
                wrong.append(f"{url_for(path)} returned {code}")
            elif served_blob_id(path, body) != blob:
                wrong.append(f"{url_for(path)} isn't the version just deployed")
        if not wrong or time.time() > deadline:
            break
        time.sleep(5)
    for path in HIDDEN_PATHS:
        code, _ = fetcher(path)
        if code == 200:
            wrong.append(f"{path} is publicly visible; it should be hidden")
    return wrong


# Running it

def confirm(question: str, yes: bool, word: str = "y") -> None:
    if yes:
        print(f"  (--yes) {question} yes")
        return
    if not sys.stdin.isatty():
        raise Stop("This needs a yes and there's no terminal to ask in",
                   "Run it in Terminal, or, only after Tommy has said yes in chat, add --yes.")
    answer = input(f"  {question} ").strip().lower()
    if answer != word and not (word == "y" and answer == "yes"):
        raise Stop("Stopped at your answer", "Nothing was deployed.")


def note_for(sha: str, branch: str | None) -> str:
    return f"commit={sha} branch={branch or 'detached'}"[:100]


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Deploy site/ to production, safely.")
    parser.add_argument("--check", action="store_true", help="run every check, but don't build or deploy")
    parser.add_argument("--yes", action="store_true",
                        help="answer prompts with yes (only after Tommy has said yes in chat); never skips a stop")
    parser.add_argument("--live-commit", metavar="COMMIT",
                        help="name the live commit yourself, when Cloudflare's history can't tell")
    parser.add_argument("--repo", type=Path, default=SCRIPT_ROOT, help=argparse.SUPPRESS)
    args = parser.parse_args(argv)
    repo = Repo(args.repo)
    cf = Cloudflare(repo)
    mode = "Checking" if args.check else "Deploying"
    branch = repo.branch()
    print(f"{mode} {SITE_URL} from {branch or 'a detached checkout'} at {repo.short('HEAD')}\n")
    try:
        fetched = repo.ok("fetch", REMOTE, "--quiet")

        print("1. Uncommitted changes")
        check_clean(repo)
        print("  ✓ site/, wrangler.jsonc and this script match the last commit\n")

        print("2. What's live")
        live, how, version_id = find_live_commit(repo, cf, args.live_commit)
        print(f"  Live: {repo.short(live)}\n  ({how}; Cloudflare version {version_id})\n")

        print("3. Live work on this branch")
        check_contains_live(repo, live)
        print("  ✓ this branch has everything that's live\n")

        print("4. Things to confirm")
        asks = confirmations(repo, fetched)
        for ask in asks:
            print(f"  ! {ask}")
        if not asks:
            print("  ✓ nothing")
        print()

        print("5. Checks")
        run_checks(repo, cf, build=not args.check)
        print()

        print("6. What this deploy adds to the site")
        added = repo.log(f"{live}..HEAD")
        site_change = repo.git("diff", "--stat", live, "HEAD", "--", "site", "wrangler.jsonc")
        for line in added:
            print(f"  {line}")
        if site_change:
            print("\n  Files that change on the site:")
            for line in site_change.splitlines():
                print(f"    {line}")
        else:
            print("\n  No files on the site change; a deploy would only record the commit.")
        print()

        if args.check:
            print("Check passed. Nothing was built or deployed.")
            if asks:
                print("A real deploy would ask you to confirm the items under 4.")
            return 0

        for ask in asks:
            confirm(f"{ask} Deploy anyway? [y/N]", args.yes)
        confirm("Type deploy to publish to production:", args.yes, word="deploy")

        print("\n7. Deploying")
        note = note_for(repo.git("rev-parse", "HEAD"), branch)
        if cf.deploy(note, repo.git("rev-parse", "--short=12", "HEAD")) != 0:
            raise Stop("wrangler deploy failed", "Cloudflare didn't accept the deploy. The live site hasn't changed.")
        new_version, new_note = cf.live_version()
        print(f"  Live is now Cloudflare version {new_version} ({new_note})\n")

        print("8. Checking the live site")
        problems = verify_live(repo)
        rollback = f"wrangler rollback {version_id} --message \"Roll back to {live[:12]}\""
        if problems:
            print("  The deploy went out but the live site doesn't look right:")
            for p in problems:
                print(f"  ✗ {p}")
            print(f"\nTo put back what was live before:\n  {rollback}")
            return 1
        print("  ✓ every page and file is the version just deployed")
        print("  ✓ hidden paths are still hidden\n")

        print(f"9. If you need to undo it\n  {rollback}\n")
        print("To do:")
        print("  - Write a release note for what changed.")
        if branch != MAIN:
            print(f"  - Merge {branch or 'this commit'} into {MAIN}, so the next deploy from {MAIN} keeps it.")
        print("  - Push when Tommy says so.")
        return 0
    except Stop as stop:
        print(f"\nSTOP: {stop.title}\n\n{stop.detail}\n\nNothing was deployed.")
        return 1


if __name__ == "__main__":
    sys.exit(main())
