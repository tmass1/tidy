{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/scripts/hooks/block-raw-deploy\"; [ -f \"$f\" ] || f=\"$CLAUDE_PROJECT_DIR/scripts/hooks/block-raw-deploy\"; [ ! -f \"$f\" ] || python3 \"$f\""
          }
        ]
      }
    ]
  }
}
